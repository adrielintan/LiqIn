NODE_ENV=production
HTTPS_ENABLED=false
APP_PORT=3000
PORT=3000
DB_PORT=5432
POSTGRES_DB=liqin
POSTGRES_USER=liqin
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://liqin:replace-with-a-long-random-password@db:5432/liqin
DATABASE_SSL=false
SESSION_COOKIE_NAME=liqin_session
SESSION_TTL_DAYS=30
UPLOAD_DIR=/var/lib/liqin/uploads
UPLOADS_CONTAINER_PATH=/var/lib/liqin/uploads
MAX_UPLOAD_BYTES=10485760
